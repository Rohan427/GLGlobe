#version 460 core

// 64-thread wavefront execution optimized for AMD RDNA3 architecture
layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct GpuEntityData
{
    vec4 position;  // xyz = Position, w = Scaling factor
    vec4 velocity;  // xyz = cartesian velocity (GL/s), w = speed cache
    vec4 metadata;  // x = Lifespan, y = Thrust, z = State ID, w = TYPE_ID
    vec4 tactical;  // x = boost time, y = max speed (GL/s), z-w tactical
};

layout (std430, binding = 0) buffer SimulationBlock
{
    GpuEntityData entities[];
};

layout (location = 0) uniform float deltaTime;
layout (location = 1) uniform float globeRadius; // Currently 1.0f
layout (location = 2) uniform float glGravity;   // Converted gravitational pull scalar (GL/s^2)

void main()
{
    uint index = gl_GlobalInvocationID.x;

    // tiny value to avoid divide by 0
    float epsilon = 1e-6;

    if (index >= entities.length()) return;

    // Fetch the Type Identifier safely from the metadata block
    float entityType = entities[index].metadata.w;
    float stateId    = entities[index].metadata.z;
    
    // Skip empty or deactivated memory slots instantly
    if (entityType == 0.0f || stateId == 30.0f) return;

    vec3 pos = entities[index].position.xyz;
    vec3 vel = entities[index].velocity.xyz;
    float glUnitsPerSecond = entities[index].velocity.w;
    float distToCenter = length (pos);
    vec3 up = pos / max (distToCenter, epsilon);

    // Apply Newtonian pull toward the Earth center (0,0,0)
    vec3 gravityPull = -up * (glGravity / (distToCenter * distToCenter));

    // Boost → ballistic (altitude and/or time)
    float alt = distToCenter - globeRadius;
    float boostTimeLimit = entities[index].tactical.x;

    // Transition: Once the threat clears 1500km altitude, kick it to ballistic phase
    float targetAltitudeThreshold = globeRadius * 1.235f;

    // =========================================================================
    // DYNAMIC TACTICAL BALLISTICS ROUTING ENGINE
    // =========================================================================
    if (entityType == 1.0f || entityType == 0.0f || stateId == 30.0f)
    {
        // TYPE_SGP4_SATELLITE: Standard clean orbit advancement
//        pos += vel * glUnitsPerSecond * deltaTime;
//        entities[index].position.xyz = pos;
        return; 
    }
    else if (entityType == 2.0f)
    {
        // TYPE_KINETIC_DEBRIS: Process gravitational falling physics on the GPU
        if (distToCenter > globeRadius)
        {
            vel += gravityPull * deltaTime;
            pos += vel * deltaTime;

            entities[index].metadata.x  -= deltaTime; // Tick down lifespan timer

            // If the lifespan expires before crashing, dissolve the fragment cleanly
            if (entities[index].metadata.x > targetAltitudeThreshold)
            {
                entities[index].metadata.z = 20.0f; // Shift to Ballistic re-entry state
            }
        }
        else
        {
            // Impact recorded: Clear slot to make it available for recycling
            entities[index].metadata.w = 0.0f;
            entities[index].tactical.x = 0.0;
            entities[index].metadata.y = 0.0;   // No more thrust
            pos = vec3 (0.0f);
            vel = vec3 (0.0f);
        }
    }
    else if (entityType == 3.0f || entityType == 4.0f)
    {
        if (stateId == 10.0f)
        {
            // STATE_LAUNCH_THRUST
            float thrustAccel = entities[index].metadata.y;
            float maxSpeed    = entities[index].tactical.y; // glUnitsPerSecond cap (set at inject)

            // Safe thrust direction: along v, or radial "up" if nearly at rest
            float speed = length (vel);
            vec3 thrustDir = (speed > epsilon)
                             ? (vel / speed)
                             : up;

            // Gravity + thrust
            vec3 acc = gravityPull + thrustDir * thrustAccel;

            vel += acc * deltaTime;

            // Enforce maximum speed (do not exceed tactical.y)
            if (maxSpeed > 0.0)
            {
                float newSpeed = length (vel);

                if (newSpeed > maxSpeed)
                {
                    vel *= (maxSpeed / newSpeed);
                }
            }

            pos += vel * deltaTime;

            if (boostTimeLimit > 0.0)
            {
                boostTimeLimit -= deltaTime;
                entities[index].tactical.x = boostTimeLimit;
            }

            // If you store elapsed time in metadata.x or tactical.z, test that too
            if (/*(alt > targetAltitudeThreshold) || */ (boostTimeLimit <= 0.0))
            {
                entities[index].metadata.z = 20.0;  // STATE_BALLISTIC
                entities[index].tactical.x = 0.0;   // No more boost time
                entities[index].metadata.y = 0.0;   // No more thrust
            }
        }
        else if (stateId == 20.0f)
        {
            // STATE_BALLISTIC: True gravitational terminal re-entry curve
            // Real Newton gravity pull: a = -G * M / r^2
            // Uses the dynamically passed uniform glGravity parameter
            // Apply the gravitational acceleration modification vector directly
            vel += gravityPull * deltaTime;
            pos += vel * deltaTime;
        }
        
        // Target Impact Validation Check
        if (length (pos) <= globeRadius)
        {
            // TODO: Maybe want to do something else for missile impact. On CPU side, GPU, both?
            entities[index].metadata.z = 30.0f; // Terminate entity state slot
            entities[index].metadata.w = 0.0f;  // Mark slot as DEAD/Recyclable
            entities[index].tactical.x = 0.0;   // No more boost time
            entities[index].metadata.y = 0.0;   // No more thrust
            entities[index].position.xyz = vec3 (0.0f);
            entities[index].velocity.xyz = vec3 (0.0f);
            return;
        }
    } // END IF-ELSE: if (entityType == 1.0f || entityType == 0.0f || stateId == 30.0f)

    // Write the data modifications back into the persistent SSBO
    entities[index].position.xyz = pos;
    entities[index].velocity.xyz = vel;
    entities[index].velocity.w = length (vel);
} // END: main()
